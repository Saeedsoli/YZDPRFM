# ══════════════════════════════════════════════════════
#  عطر یزد — نمونه متغیرهای محیطی
# ══════════════════════════════════════════════════════
#
#  این فایل الگوست و در مخزن می‌ماند.
#  نسخه واقعی را `.env` بنامید — گیت آن را نادیده می‌گیرد.
#
#  روی لیارا این مقادیر با دستور زیر ثبت می‌شوند، نه با فایل:
#    liara env set KEY="value" --app yazdperfume

# ── پنل مدیریت ──
# 🔴 رمز پیش‌فرض `yazd1404` در مستندات عمومی نوشته شده.
#    پیش از افتتاح حتماً عوض شود.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-before-launch

# ── دیتابیس ──
# محلی خالی بگذارید تا data/yazd.db استفاده شود.
# روی لیارا باید به Disk پایدار اشاره کند:
DB_PATH=/app/data/yazd.db

# ── نشانی سایت ──
# در نقشه سایت، فاکتور و پیامک استفاده می‌شود
SITE_URL=https://yazdperfume.ir
PORT=3000

# ── پروکسی معکوس ──
# تا شناسایی و آزمایش مسیر واقعی لیارا خالی بماند: هدر IP نادیده گرفته می‌شود.
# فقط IP یا CIDR دقیق پروکسی‌های مورد اعتماد، با کاما جدا شود؛ نه wildcard.
TRUSTED_PROXY_CIDRS=

# ── درگاه پرداخت ──
# sandbox = درگاه آزمایشی، هیچ پولی جابه‌جا نمی‌شود
# zarinpal = درگاه واقعی، نیازمند Merchant ID
PAYMENT_GATEWAY=sandbox
ZARINPAL_MERCHANT_ID=

# ── پیامک (پیامیتو) ──
# console = فقط در لاگ چاپ می‌شود، پیامکی ارسال نمی‌گردد
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# ── نگهداشت ──
BACKUP_DISABLED=0
AUDIT_KEEP_DAYS=90
ANALYTICS_KEEP_DAYS=180
SHOWCASE_REFRESH_HOURS=1
